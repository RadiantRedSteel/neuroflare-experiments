        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# --- Slider Scaling ---&amp;#10;slider_pain_width = aspect * 0.7   # 70% of screen width&amp;#10;&amp;#10;# Slider layout (height units)&amp;#10;slider_pain_y      = -0.09                     # vertical position of the slider center&amp;#10;slider_pain_height = 0.06                      # slider thickness/height" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="&amp;#10;        // add-on: list(s: string): string[]&amp;#10;        function list(s) {&amp;#10;            // if s is a string, we return a list of its characters&amp;#10;            if (typeof s === 'string')&amp;#10;                return s.split('');&amp;#10;            else&amp;#10;                // otherwise we return s:&amp;#10;                return s;&amp;#10;        }&amp;#10;&amp;#10;        [screen_width, screen_height] = psychoJS.window.size;&amp;#10;aspect = (screen_width / screen_height);&amp;#10;leftEdge = ((- aspect) / 2);&amp;#10;rightEdge = (aspect / 2);&amp;#10;topEdge = 0.5;&amp;#10;bottomEdge = (- 0.5);&amp;#10;slider_gen_width = (aspect * 0.7);&amp;#10;sam_px_width = 1168;&amp;#10;sam_px_height = 231;&amp;#10;sam_aspect = (sam_px_width / sam_px_height);&amp;#10;pictogram_px_width = 215;&amp;#10;gap_px_width = 23;&amp;#10;num_pictograms = 5;&amp;#10;num_gaps = (num_pictograms - 1);&amp;#10;total_calc_px = ((num_pictograms * pictogram_px_width) + (num_gaps * gap_px_width));&amp;#10;sam_height = 0.25;&amp;#10;sam_width = (sam_height * sam_aspect);&amp;#10;sam_y = 0.1;&amp;#10;slider_y = (- 0.09);&amp;#10;slider_height = 0.06;&amp;#10;slider_px_width = (sam_px_width - 215);&amp;#10;slider_width = (sam_width * (slider_px_width / sam_px_width));&amp;#10;label_y = (slider_y - 0.2);&amp;#10;scale_factor = (sam_width / sam_px_width);&amp;#10;pictogram_w = (pictogram_px_width * scale_factor);&amp;#10;gap_w = (gap_px_width * scale_factor);&amp;#10;tick_positions = [];&amp;#10;x = (((- sam_width) / 2) + (pictogram_w / 2));&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(9), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    tick_positions.push(x);&amp;#10;    if (((i % 2) === 0)) {&amp;#10;        x += ((pictogram_w / 2) + (gap_w / 2));&amp;#10;    } else {&amp;#10;        x += ((gap_w / 2) + (pictogram_w / 2));&amp;#10;    }&amp;#10;}&amp;#10;tick_values = list(util.range(1, 10));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="allowContinue = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="allowContinue = False&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Check if either slider has been rated&amp;#10;rated = (slider_pain_adj.getRating() is not None) &amp;#10;&amp;#10;# If rated, allow spacebar to end the routine&amp;#10;if rated:&amp;#10;    allowContinue = True&amp;#10;else:&amp;#10;    allowContinue = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="rated = (pain_slider_2.getRating() !== null);&amp;#10;if (rated) {&amp;#10;    allowContinue = true;&amp;#10;} else {&amp;#10;    allowContinue = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_pain_helper" valType="code" updates="None" name="name"/>
      </CodeComponent>
