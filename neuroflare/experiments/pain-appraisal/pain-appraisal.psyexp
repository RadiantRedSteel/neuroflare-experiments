    <Routine name="intro"/>
    <LoopInitiator loopType="TrialHandler" name="pain_adjectives_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'pain_adjs': 'Throbbing'}, {'pain_adjs': 'Shooting'}, {'pain_adjs': 'Stabbing'}, {'pain_adjs': 'Sharp'}, {'pain_adjs': 'Gnawing'}, {'pain_adjs': 'Hot-Burning'}, {'pain_adjs': 'Aching'}, {'pain_adjs': 'Heavy'}, {'pain_adjs': 'Tender'}, {'pain_adjs': 'Splitting'}, {'pain_adjs': 'Tiring-Exhausting'}, {'pain_adjs': 'Sickening'}, {'pain_adjs': 'Fearful'}, {'pain_adjs': 'Punishing-Cruel'}, {'pain_adjs': 'Cramping'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="pain_adjectives_01.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="pain_adjectives_loop" valType="code"/>
      <Param name="random seed" updates="None" val="1234" valType="code"/>
    </LoopInitiator>
    <Routine name="fixation"/>
    <Routine name="pain_adjectives01"/>
    <LoopTerminator name="pain_adjectives_loop"/>
    <LoopInitiator loopType="TrialHandler" name="pain_adjectives_loop2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'pain_adjs': 'Throbbing'}, {'pain_adjs': 'Shooting'}, {'pain_adjs': 'Stabbing'}, {'pain_adjs': 'Sharp'}, {'pain_adjs': 'Gnawing'}, {'pain_adjs': 'Hot-Burning'}, {'pain_adjs': 'Aching'}, {'pain_adjs': 'Heavy'}, {'pain_adjs': 'Tender'}, {'pain_adjs': 'Splitting'}, {'pain_adjs': 'Tiring-Exhausting'}, {'pain_adjs': 'Sickening'}, {'pain_adjs': 'Fearful'}, {'pain_adjs': 'Punishing-Cruel'}, {'pain_adjs': 'Cramping'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="pain_adjectives_01.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="pain_adjectives_loop2" valType="code"/>
      <Param name="random seed" updates="None" val="1" valType="code"/>
    </LoopInitiator>
    <Routine name="fixation"/>
    <Routine name="pain_adjectives02"/>
    <LoopTerminator name="pain_adjectives_loop2"/>
