      <Param name="name" updates="None" val="state_measure_end" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="stateMeasure"/>
    <LoopTerminator name="state_measure_end"/>
    <Routine name="goodbye"/>
  </Flow>
</PsychoPy2experiment>
