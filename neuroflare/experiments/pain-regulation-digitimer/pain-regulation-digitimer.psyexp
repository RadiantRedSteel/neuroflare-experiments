        <Param val="# Skip the delay fixation on the final trial.&amp;#10;fixation_duration = 60&amp;#10;skip_fixation_counter = 0&amp;#10;skip_fixation_target = 5" valType="extendedCode" updates="constant" name="Begin Experiment"/>
