      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="regulation_block" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="instruction"/>
    <LoopInitiator loopType="TrialHandler" name="seconds">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('regulation_seconds', np.int64(0))]), OrderedDict([('regulation_seconds', np.int64(1))]), OrderedDict([('regulation_seconds', np.int64(2))]), OrderedDict([('regulation_seconds', np.int64(3))]), OrderedDict([('regulation_seconds', np.int64(4))]), OrderedDict([('regulation_seconds', np.int64(5))]), OrderedDict([('regulation_seconds', np.int64(6))]), OrderedDict([('regulation_seconds', np.int64(7))]), OrderedDict([('regulation_seconds', np.int64(8))]), OrderedDict([('regulation_seconds', np.int64(9))]), OrderedDict([('regulation_seconds', np.int64(10))]), OrderedDict([('regulation_seconds', np.int64(11))]), OrderedDict([('regulation_seconds', np.int64(12))]), OrderedDict([('regulation_seconds', np.int64(13))]), OrderedDict([('regulation_seconds', np.int64(14))]), OrderedDict([('regulation_seconds', np.int64(15))])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="pain-regulation_loop_seconds.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="seconds" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="regulation"/>
    <LoopTerminator name="seconds"/>
    <Routine name="transition"/>
    <LoopInitiator loopType="TrialHandler" name="state_measure_regulation">
      <Param name="Selected rows" updates="None" val="8" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('rating_category', 'fatigue')]), OrderedDict([('rating_category', 'sleepiness')]), OrderedDict([('rating_category', 'pain')]), OrderedDict([('rating_category', 'pain_unpleasantness')]), OrderedDict([('rating_category', 'sam_valence')]), OrderedDict([('rating_category', 'sam_arousal')]), OrderedDict([('rating_category', 'sam_dominance')]), OrderedDict([('rating_category', 'emotion_regulation')]), OrderedDict([('rating_category', 'pain_regulation_confidence')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="../../shared/loop-templates/loopStateMeasure.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="state_measure_regulation" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="stateMeasure"/>
    <LoopTerminator name="state_measure_regulation"/>
    <LoopTerminator name="regulation_block"/>
    <LoopInitiator loopType="TrialHandler" name="state_measure_pain">
      <Param name="Selected rows" updates="None" val="2" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('rating_category', 'fatigue')]), OrderedDict([('rating_category', 'sleepiness')]), OrderedDict([('rating_category', 'pain')]), OrderedDict([('rating_category', 'pain_unpleasantness')]), OrderedDict([('rating_category', 'sam_valence')]), OrderedDict([('rating_category', 'sam_arousal')]), OrderedDict([('rating_category', 'sam_dominance')]), OrderedDict([('rating_category', 'emotion_regulation')]), OrderedDict([('rating_category', 'pain_regulation_confidence')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="../../shared/loop-templates/loopStateMeasure.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="state_measure_pain" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="stateMeasure"/>
    <LoopTerminator name="state_measure_pain"/>
    <Routine name="delay"/>
    <LoopTerminator name="technique_trial"/>
    <LoopTerminator name="pain_level_trial"/>
    <LoopInitiator loopType="TrialHandler" name="state_measure_end">
      <Param name="Selected rows" updates="None" val="[0, 1, 3, 4, 5, 6]" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('rating_category', 'fatigue')]), OrderedDict([('rating_category', 'sleepiness')]), OrderedDict([('rating_category', 'pain')]), OrderedDict([('rating_category', 'pain_unpleasantness')]), OrderedDict([('rating_category', 'sam_valence')]), OrderedDict([('rating_category', 'sam_arousal')]), OrderedDict([('rating_category', 'sam_dominance')]), OrderedDict([('rating_category', 'emotion_regulation')]), OrderedDict([('rating_category', 'pain_regulation_confidence')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="../../shared/loop-templates/loopStateMeasure.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
